# --- 層一:Travelpayouts(Aviasales)快取價 ---------------------------------
# 參考資料(國家/城市/機場)不需要 token,沒填也能跑;查價需要。
# 免費 affiliate 註冊:https://www.travelpayouts.com
#
# 這裡留空也沒關係:網頁上的「查價金鑰」面板可以直接填,金鑰只存在該瀏覽器、
# 隨請求送出、伺服器不落地。填在這裡的效果是「對所有訪客生效」——
# 站台是公開的,所以只有在你確定要讓每個人共用你的額度時才填。
TRAVELPAYOUTS_TOKEN=
# affiliate marker,填了之後 Aviasales 深連結會帶上你的推薦碼(可留空)
TRAVELPAYOUTS_MARKER=

# 每日價要用哪個端點。由 scripts/spike_datasource.py 實測決定,
# 不要憑文件猜 —— 兩個端點對「單程」的定義可能不同。
AIR_PRICE_MONTH_ENDPOINT=month-matrix
AIR_PRICE_CACHE_TTL_HOURS=6

# --- 層二:即時實價(選配) ------------------------------------------------
# 留空 = 走深連結,產品完整可用。
# 填了 Duffel live token = 站內直接顯示即時實價(搜尋免費,只有開票收 $3/訂單)。
# 注意:Duffel test mode 是虛構航空、價格不真實,填 test token 沒有意義。
DUFFEL_TOKEN=
DUFFEL_API_VERSION=v2

# --- 一般設定 --------------------------------------------------------------
AIR_DB_PATH=/data/air.sqlite3
AIR_CURRENCY=TWD
AIR_HTTP_TIMEOUT=20
AIR_DEBUG=false
